# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key from https://aistudio.google.com (Get API key). Free tier, no card needed.
GEMINI_API_KEY=

# Models (change here, not in code)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Embeddings run locally (downloaded once, ~500 MB)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Local vector database (ChromaDB stores its files in data/chroma)
CHROMA_COLLECTION=reglens-chunks

# Retrieval
TOP_K=5
# Experiment B: translate English questions to Bahasa before searching (uses Gemini)
TRANSLATE_QUERIES=true
# Experiment C: push attachment (LAMPIRAN) chunks down the ranking. 0 = off
LAMPIRAN_PENALTY=0.03
# Experiment A: add BM25 keyword search, merged with vector search
HYBRID_SEARCH=false
